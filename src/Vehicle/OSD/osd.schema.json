{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mavlink.io/component_metadata/osd.schema.json",
  "title": "OSD component metadata (COMP_METADATA_TYPE_OSD)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "displays"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "translation": {
      "type": "object"
    },
    "displays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/display"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
    },
    "paramName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,15}$"
    },
    "uri": {
      "type": "string",
      "pattern": "^mftp://"
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "driver",
        "name",
        "model",
        "reload",
        "enable",
        "canvases",
        "cell",
        "font",
        "profiles",
        "features",
        "elements",
        "layout",
        "defaults"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "driver": {
          "$ref": "#/$defs/id",
          "description": "PX4 module name"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "enum": [
            "grid",
            "pixel"
          ]
        },
        "reload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param"
          ],
          "properties": {
            "param": {
              "$ref": "#/$defs/paramName",
              "description": "Increment after writing the layout or firmware file; the driver reloads on the change"
            }
          }
        },
        "enable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param",
            "disabled"
          ],
          "properties": {
            "param": {
              "$ref": "#/$defs/paramName"
            },
            "disabled": {
              "type": "integer",
              "description": "Parameter value meaning the driver is not running"
            }
          }
        },
        "canvases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/canvas"
          }
        },
        "cell": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "font": {
          "type": "string",
          "enum": [
            "betaflight",
            "inav",
            "ardupilot"
          ]
        },
        "profiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "blink",
              "label",
              "bbox",
              "firmware"
            ]
          }
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "texts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text_slot"
          }
        },
        "layout": {
          "$ref": "#/$defs/file"
        },
        "firmware": {
          "$ref": "#/$defs/file"
        },
        "defaults": {
          "$ref": "#/$defs/layout"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "const": "pixel"
              }
            }
          },
          "then": {
            "required": [
              "channels"
            ]
          }
        }
      ]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cols",
        "rows"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 32
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Overlay width in pixels; pixel displays only"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Overlay height in pixels; pixel displays only"
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param",
            "value"
          ],
          "properties": {
            "param": {
              "$ref": "#/$defs/paramName"
            },
            "value": {
              "type": "integer"
            }
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 48
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "Cells; 0 when the element is not cell-shaped"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 32
          }
        },
        "bind": {
          "$ref": "#/$defs/bind"
        }
      }
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "label",
            "value",
            "horizon",
            "compass",
            "crosshair",
            "bbox",
            "text"
          ]
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "format": {
          "type": "string",
          "enum": [
            "int",
            "f1",
            "f0",
            "deg",
            "mode",
            "arm",
            "f2",
            "latlon",
            "time",
            "sdeg",
            "pct"
          ]
        },
        "suffix": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^[ -~]*$"
        }
      }
    },
    "text_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "name": {
          "type": "string"
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "units": {
          "type": "string",
          "maxLength": 8
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "$ref": "#/$defs/uri"
        }
      }
    },
    "layout": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "https://mavlink.io/component_metadata/osd_layout.schema.json",
      "title": "OSD layout document",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "display",
        "canvas",
        "elements"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "display": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
        },
        "canvas": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
        },
        "elements": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/layout/$defs/element"
          }
        },
        "betaflight": {
          "type": "object",
          "description": "The rest of MSP_OSD_CONFIG for interchange with a Betaflight target; ignored by PX4 drivers"
        }
      },
      "$defs": {
        "element": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
            },
            "col": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "row": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "x": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            },
            "y": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            },
            "visible": {
              "type": "boolean",
              "default": true
            },
            "profiles": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "default": [
                1
              ]
            },
            "variant": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "default": 0
            },
            "blink": {
              "type": "boolean",
              "default": false
            },
            "text": {
              "type": "string",
              "maxLength": 8,
              "pattern": "^[ -~]*$"
            },
            "bind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "channel": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "int",
                    "f1",
                    "f0",
                    "deg",
                    "mode",
                    "arm",
                    "f2",
                    "latlon",
                    "time",
                    "sdeg",
                    "pct"
                  ]
                },
                "suffix": {
                  "type": "string",
                  "maxLength": 8,
                  "pattern": "^[ -~]*$"
                }
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "col",
                "row"
              ]
            },
            {
              "required": [
                "x",
                "y"
              ]
            }
          ],
          "dependencies": {
            "col": [
              "row"
            ],
            "row": [
              "col"
            ],
            "x": [
              "y"
            ],
            "y": [
              "x"
            ]
          }
        }
      }
    }
  }
}
